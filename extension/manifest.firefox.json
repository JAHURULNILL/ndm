{
  "manifest_version": 3,
  "name": "Nill Download Manager",
  "version": "2.3.4",
  "description": "Send downloads and online videos from your browser to Nill Download Manager, a fast desktop download manager.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "alarms",
    "nativeMessaging",
    "contextMenus",
    "notifications",
    "downloads",
    "activeTab",
    "tabs",
    "webRequest",
    "storage",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "fb-classify.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "fb-classify.js",
        "page-hook.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fb-classify.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ndm@nill.download"
    }
  }
}
